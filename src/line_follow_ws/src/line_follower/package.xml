<?xml version="1.0"?>
<package format="3">
  <name>line_follower</name>
  <version>0.1.0</version>
  <description>ROS 2 line following node implementing the official OriginCar image-processing pipeline using C++.</description>
  <maintainer email="maintainer@example.com">OriginCar Dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>ament_index_cpp</depend>
  <depend>std_msgs</depend>
  <depend>ai_msgs</depend>

  <exec_depend>opencv</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
